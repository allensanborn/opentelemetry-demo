@startuml
title <size:24>Container View: Astronomy Shop</size>\n<size:24>Cross-cutting view: every container exports OpenTelemetry data to the observability backend.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Infrastructure
  .Element-RWxlbWVudCxDb250YWluZXIsSW5mcmFzdHJ1Y3R1cmU= {
    BackgroundColor: #6b4fbb;
    LineColor: #4a3782;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw= {
    BackgroundColor: #8a8a8a;
    LineColor: #606060;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship,Telemetry
  .Relationship-UmVsYXRpb25zaGlwLFRlbGVtZXRyeQ== {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #7a7a7a;
    FontColor: #7a7a7a;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Astronomy Shop
  .Boundary-QXN0cm9ub215IFNob3A= {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #1168bd;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Chat / AI Assistant
  .Group-Q2hhdCAvIEFJIEFzc2lzdGFudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Edge & Web
  .Group-RWRnZSAmIFdlYg== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Order Processing (async)
  .Group-T3JkZXIgUHJvY2Vzc2luZyAoYXN5bmMp {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Platform
  .Group-UGxhdGZvcm0= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Shop Services
  .Group-U2hvcCBTZXJ2aWNlcw== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "==Observability Backend\n<size:16>[Software System]</size>\n\nOpenTelemetry Collector plus Jaeger, Prometheus, Grafana, and OpenSearch; receives all traces, metrics, and logs." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as ObservabilityBackend

rectangle "Astronomy Shop\n<size:16>[Software System]</size>" <<Boundary-QXN0cm9ub215IFNob3A=>> {
  rectangle "Chat / AI Assistant" <<Group-Q2hhdCAvIEFJIEFzc2lzdGFudA==>> as group9 {
    rectangle "==Chatbot\n<size:16>[Container: Python / FastAPI]</size>\n\nChat UI for the shopping assistant." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Chatbot
    rectangle "==Agent\n<size:16>[Container: Python / LangChain + LangGraph]</size>\n\nLLM agent that answers shopping questions by calling shop tools and an external model." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Agent
    rectangle "==MCP Server\n<size:16>[Container: Python / FastMCP]</size>\n\nExposes the shop's REST API to the agent as MCP tools." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.MCPServer
  }

  rectangle "Edge & Web" <<Group-RWRnZSAmIFdlYg==>> as group10 {
    rectangle "==Frontend Proxy\n<size:16>[Container: Envoy]</size>\n\nSingle public entrypoint; routes browser traffic to the web app, images, chat, and observability UIs." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.FrontendProxy
    rectangle "==Frontend\n<size:16>[Container: TypeScript / Next.js]</size>\n\nServer-rendered web store and backend-for-frontend that aggregates the shop services." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Frontend
    rectangle "==Image Provider\n<size:16>[Container: nginx]</size>\n\nServes static product images." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.ImageProvider
  }

  rectangle "Order Processing (async)" <<Group-T3JkZXIgUHJvY2Vzc2luZyAoYXN5bmMp>> as group11 {
    rectangle "==Accounting\n<size:16>[Container: C# / .NET]</size>\n\nRecords placed orders for bookkeeping." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Accounting
    rectangle "==Fraud Detection\n<size:16>[Container: Kotlin / JVM]</size>\n\nFlags potentially fraudulent orders." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.FraudDetection
  }

  rectangle "Platform" <<Group-UGxhdGZvcm0=>> as group12 {
    rectangle "==flagd\n<size:16>[Container: Go / OpenFeature]</size>\n\nFeature-flag service; evaluates the flags that drive the demo's failure scenarios. Queried by the shop services." <<Element-RWxlbWVudCxDb250YWluZXIsSW5mcmFzdHJ1Y3R1cmU=>> as AstronomyShop.flagd
  }

  rectangle "Shop Services" <<Group-U2hvcCBTZXJ2aWNlcw==>> as group13 {
    rectangle "==Cart\n<size:16>[Container: C# / .NET]</size>\n\nHolds each user's shopping cart." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Cart
    rectangle "==Checkout\n<size:16>[Container: Go]</size>\n\nOrchestrates order placement across cart, payment, shipping, and email." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Checkout
    rectangle "==Currency\n<size:16>[Container: C++]</size>\n\nConverts money between currencies." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Currency
    rectangle "==Product Catalog\n<size:16>[Container: Go]</size>\n\nLists and looks up products." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.ProductCatalog
    rectangle "==Recommendation\n<size:16>[Container: Python]</size>\n\nSuggests related products." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Recommendation
    rectangle "==Payment\n<size:16>[Container: Node.js]</size>\n\nCharges the order to a credit card (mock)." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Payment
    rectangle "==Shipping\n<size:16>[Container: Rust]</size>\n\nCalculates shipping cost and ships the order." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Shipping
    rectangle "==Quote\n<size:16>[Container: PHP]</size>\n\nComputes shipping-cost quotes." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Quote
    rectangle "==Email\n<size:16>[Container: Ruby / Sinatra]</size>\n\nSends the order-confirmation email (mock)." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Email
    rectangle "==Ad\n<size:16>[Container: Java]</size>\n\nReturns contextual ads for a product category." <<Element-RWxlbWVudCxDb250YWluZXI=>> as AstronomyShop.Ad
  }

}

