@startuml
title <size:24>Container View: Shopping Assistant</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw= {
    BackgroundColor: #8a8a8a;
    LineColor: #606060;
    LineStyle: 10-10;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Shopping Assistant
  .Boundary-U2hvcHBpbmcgQXNzaXN0YW50 {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #1168bd;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "==Storefront\n<size:16>[Software System]</size>\n\nPublic web store and API gateway. (Team: Web)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Storefront
rectangle "==LLM API\n<size:16>[Software System]</size>\n\nThird-party OpenAI-compatible model endpoint." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as LLMAPI

rectangle "Shopping Assistant\n<size:16>[Software System]</size>" <<Boundary-U2hvcHBpbmcgQXNzaXN0YW50>> {
  rectangle "==Chatbot\n<size:16>[Container: Python / FastAPI]</size>\n\nChat UI for the assistant." <<Element-RWxlbWVudCxDb250YWluZXI=>> as ShoppingAssistant.Chatbot
  rectangle "==Agent\n<size:16>[Container: Python / LangChain + LangGraph]</size>\n\nLLM agent; calls shop tools and an external model." <<Element-RWxlbWVudCxDb250YWluZXI=>> as ShoppingAssistant.Agent
  rectangle "==MCP Server\n<size:16>[Container: Python / FastMCP]</size>\n\nExposes the shop API to the agent as MCP tools." <<Element-RWxlbWVudCxDb250YWluZXI=>> as ShoppingAssistant.MCPServer
}

Storefront --> ShoppingAssistant.Chatbot <<Relationship-UmVsYXRpb25zaGlw>> : "Routes chat requests to\n<size:16>[HTTP]</size>"
ShoppingAssistant.Chatbot --> ShoppingAssistant.Agent <<Relationship-UmVsYXRpb25zaGlw>> : "Forwards user prompts to\n<size:16>[HTTP]</size>"
ShoppingAssistant.Agent --> ShoppingAssistant.MCPServer <<Relationship-UmVsYXRpb25zaGlw>> : "Invokes shop tools via\n<size:16>[HTTP (MCP)]</size>"
ShoppingAssistant.Agent --> LLMAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Sends prompts to\n<size:16>[HTTPS]</size>"
ShoppingAssistant.MCPServer --> Storefront <<Relationship-UmVsYXRpb25zaGlw>> : "Calls the shop REST API on\n<size:16>[HTTP]</size>"

@enduml