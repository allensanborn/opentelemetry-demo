@startuml
title <size:24>Container View: Checkout & Orders</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Queue
  .Element-RWxlbWVudCxDb250YWluZXIsUXVldWU= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Checkout & Orders
  .Boundary-Q2hlY2tvdXQgJiBPcmRlcnM= {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #1168bd;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "==Storefront\n<size:16>[Software System]</size>\n\nPublic web store and API gateway. (Team: Web)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Storefront
rectangle "==Product Catalog\n<size:16>[Software System]</size>\n\nOwns product data and lookup. (Team: Catalog)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ProductCatalog
rectangle "==Cart\n<size:16>[Software System]</size>\n\nOwns the shopping cart. (Team: Cart)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Cart
rectangle "==Payments\n<size:16>[Software System]</size>\n\nCard charging. (Team: Payments)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Payments
rectangle "==Shipping\n<size:16>[Software System]</size>\n\nShipping cost and fulfilment. (Team: Fulfilment)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Shipping
rectangle "==Notifications\n<size:16>[Software System]</size>\n\nCustomer messaging. (Team: Comms)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Notifications
rectangle "==Currency\n<size:16>[Software System]</size>\n\nShared currency conversion. (Team: Platform / Shared Services)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Currency

rectangle "Checkout & Orders\n<size:16>[Software System]</size>" <<Boundary-Q2hlY2tvdXQgJiBPcmRlcnM=>> {
  rectangle "==Checkout Service\n<size:16>[Container: Go]</size>\n\nOrchestrates order placement across cart, payment, shipping, and email." <<Element-RWxlbWVudCxDb250YWluZXI=>> as CheckoutOrders.CheckoutService
  rectangle "==Accounting Service\n<size:16>[Container: C# / .NET]</size>\n\nRecords placed orders for bookkeeping." <<Element-RWxlbWVudCxDb250YWluZXI=>> as CheckoutOrders.AccountingService
  rectangle "==Fraud Detection Service\n<size:16>[Container: Kotlin / JVM]</size>\n\nFlags potentially fraudulent orders." <<Element-RWxlbWVudCxDb250YWluZXI=>> as CheckoutOrders.FraudDetectionService
  queue "==Order Bus\n<size:16>[Container: Apache Kafka]</size>\n\nStreams placed-order events to the async consumers (topic: orders)." <<Element-RWxlbWVudCxDb250YWluZXIsUXVldWU=>> as CheckoutOrders.OrderBus
  database "==Accounting DB\n<size:16>[Container: PostgreSQL]</size>\n\nOrder records — the accounting schema/database this team owns and deploys independently." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as CheckoutOrders.AccountingDB
}

CheckoutOrders.CheckoutService --> ProductCatalog <<Relationship-UmVsYXRpb25zaGlw>> : "Looks up product details via\n<size:16>[gRPC]</size>"
CheckoutOrders.CheckoutService --> Payments <<Relationship-UmVsYXRpb25zaGlw>> : "Charges the order via\n<size:16>[gRPC]</size>"
CheckoutOrders.CheckoutService --> Shipping <<Relationship-UmVsYXRpb25zaGlw>> : "Ships the order via\n<size:16>[HTTP]</size>"
CheckoutOrders.CheckoutService --> Notifications <<Relationship-UmVsYXRpb25zaGlw>> : "Sends the confirmation email via\n<size:16>[HTTP]</size>"
CheckoutOrders.CheckoutService --> CheckoutOrders.OrderBus <<Relationship-UmVsYXRpb25zaGlw>> : "Publishes 'orders' events to\n<size:16>[Kafka]</size>"
CheckoutOrders.AccountingService --> CheckoutOrders.OrderBus <<Relationship-UmVsYXRpb25zaGlw>> : "Consumes 'orders' events from\n<size:16>[Kafka]</size>"
CheckoutOrders.FraudDetectionService --> CheckoutOrders.OrderBus <<Relationship-UmVsYXRpb25zaGlw>> : "Consumes 'orders' events from\n<size:16>[Kafka]</size>"
CheckoutOrders.AccountingService --> CheckoutOrders.AccountingDB <<Relationship-UmVsYXRpb25zaGlw>> : "Writes order records to\n<size:16>[SQL]</size>"
Storefront --> Cart <<Relationship-UmVsYXRpb25zaGlw>> : "Reads and updates the cart via\n<size:16>[gRPC]</size>"
Storefront --> CheckoutOrders.CheckoutService <<Relationship-UmVsYXRpb25zaGlw>> : "Places orders through\n<size:16>[gRPC]</size>"
Storefront --> Currency <<Relationship-UmVsYXRpb25zaGlw>> : "Converts prices via\n<size:16>[gRPC]</size>"
Storefront --> ProductCatalog <<Relationship-UmVsYXRpb25zaGlw>> : "Looks up products via\n<size:16>[gRPC]</size>"
Storefront --> Shipping <<Relationship-UmVsYXRpb25zaGlw>> : "Requests shipping quotes from\n<size:16>[HTTP]</size>"
CheckoutOrders.CheckoutService --> Cart <<Relationship-UmVsYXRpb25zaGlw>> : "Reads and clears the cart via\n<size:16>[gRPC]</size>"
CheckoutOrders.CheckoutService --> Currency <<Relationship-UmVsYXRpb25zaGlw>> : "Converts order totals via\n<size:16>[gRPC]</size>"

@enduml