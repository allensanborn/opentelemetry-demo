@startuml
title <size:24>Container View: Product Catalog</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Product Catalog
  .Boundary-UHJvZHVjdCBDYXRhbG9n {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #1168bd;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "==Storefront\n<size:16>[Software System]</size>\n\nPublic web store and API gateway. (Team: Web)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Storefront
rectangle "==Recommendations\n<size:16>[Software System]</size>\n\nSuggests related products. (Team: Growth)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Recommendations
rectangle "==Checkout & Orders\n<size:16>[Software System]</size>\n\nOrder placement and the async order lifecycle. (Team: Orders)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as CheckoutOrders

rectangle "Product Catalog\n<size:16>[Software System]</size>" <<Boundary-UHJvZHVjdCBDYXRhbG9n>> {
  rectangle "==Product Catalog Service\n<size:16>[Container: Go]</size>\n\nLists and looks up products." <<Element-RWxlbWVudCxDb250YWluZXI=>> as ProductCatalog.ProductCatalogService
  database "==Catalog DB\n<size:16>[Container: PostgreSQL]</size>\n\nProduct data — the catalog schema/database this team owns and deploys independently." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as ProductCatalog.CatalogDB
}

CheckoutOrders --> ProductCatalog.ProductCatalogService <<Relationship-UmVsYXRpb25zaGlw>> : "Looks up product details via\n<size:16>[gRPC]</size>"
ProductCatalog.ProductCatalogService --> ProductCatalog.CatalogDB <<Relationship-UmVsYXRpb25zaGlw>> : "Reads product data from\n<size:16>[SQL]</size>"
Recommendations --> ProductCatalog.ProductCatalogService <<Relationship-UmVsYXRpb25zaGlw>> : "Looks up product details via\n<size:16>[gRPC]</size>"
Storefront --> CheckoutOrders <<Relationship-UmVsYXRpb25zaGlw>> : "Places orders through\n<size:16>[gRPC]</size>"
Storefront --> ProductCatalog.ProductCatalogService <<Relationship-UmVsYXRpb25zaGlw>> : "Looks up products via\n<size:16>[gRPC]</size>"
Storefront --> Recommendations <<Relationship-UmVsYXRpb25zaGlw>> : "Requests recommendations from\n<size:16>[gRPC]</size>"

@enduml