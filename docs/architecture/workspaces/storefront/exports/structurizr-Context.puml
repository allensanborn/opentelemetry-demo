@startuml
title <size:24>System Context View: Storefront</size>\n<size:24>Storefront in its landscape: who uses it and the systems it depends on.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw= {
    BackgroundColor: #8a8a8a;
    LineColor: #606060;
    LineStyle: 10-10;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,Platform
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sUGxhdGZvcm0= {
    BackgroundColor: #667085;
    LineColor: #474e5d;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,FeatureFlag
  .Relationship-UmVsYXRpb25zaGlwLEZlYXR1cmVGbGFn {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #7a7a7a;
    FontColor: #7a7a7a;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Telemetry
  .Relationship-UmVsYXRpb25zaGlwLFRlbGVtZXRyeQ== {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #7a7a7a;
    FontColor: #7a7a7a;
    FontSize: 24;
    MaximumWidth: 200;
  }
</style>

rectangle "==Storefront\n<size:16>[Software System]</size>\n\nPublic web store and API gateway. (Team: Web)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Storefront
rectangle "==Currency\n<size:16>[Software System]</size>\n\nShared currency conversion. (Team: Shared Services)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Currency
rectangle "==Feature Flags\n<size:16>[Software System]</size>\n\nFeature-flag evaluation over OpenFeature/OFREP. (Team: Platform)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sUGxhdGZvcm0=>> as FeatureFlags
rectangle "==Observability Platform\n<size:16>[Software System]</size>\n\nTelemetry ingest, storage, and dashboards over OTLP. (Team: Platform)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sUGxhdGZvcm0=>> as ObservabilityPlatform
rectangle "==Load Generator\n<size:16>[Software System]</size>\n\nSimulates real users with synthetic traffic (k6)." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as LoadGenerator
rectangle "==Shopping Assistant\n<size:16>[Software System]</size>\n\nConversational shopping help backed by an LLM. (Team: AI)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ShoppingAssistant
rectangle "==Product Catalog\n<size:16>[Software System]</size>\n\nOwns product data and lookup. (Team: Catalog)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ProductCatalog
rectangle "==Recommendations\n<size:16>[Software System]</size>\n\nSuggests related products. (Team: Growth)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Recommendations
person "==Customer\n<size:16>[Person]</size>\n\nBrowses the catalog, places orders, and chats." <<Element-RWxlbWVudCxQZXJzb24=>> as Customer
rectangle "==Ads\n<size:16>[Software System]</size>\n\nContextual advertising. (Team: Growth)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Ads
rectangle "==Cart\n<size:16>[Software System]</size>\n\nOwns the shopping cart. (Team: Cart)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Cart
rectangle "==Checkout & Orders\n<size:16>[Software System]</size>\n\nOrder placement and the async order lifecycle. (Team: Orders)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as CheckoutOrders
rectangle "==Shipping\n<size:16>[Software System]</size>\n\nShipping cost and fulfilment. (Team: Fulfilment)" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Shipping

Storefront --> ShoppingAssistant <<Relationship-UmVsYXRpb25zaGlw>> : "Routes chat requests to\n<size:16>[HTTP]</size>"
Storefront --> Ads <<Relationship-UmVsYXRpb25zaGlw>> : "Requests contextual ads from\n<size:16>[gRPC]</size>"
Storefront --> Cart <<Relationship-UmVsYXRpb25zaGlw>> : "Reads and updates the cart via\n<size:16>[gRPC]</size>"
Storefront --> CheckoutOrders <<Relationship-UmVsYXRpb25zaGlw>> : "Places orders through\n<size:16>[gRPC]</size>"
Storefront --> Currency <<Relationship-UmVsYXRpb25zaGlw>> : "Converts prices via\n<size:16>[gRPC]</size>"
Storefront --> ProductCatalog <<Relationship-UmVsYXRpb25zaGlw>> : "Looks up products via\n<size:16>[gRPC]</size>"
Storefront --> Recommendations <<Relationship-UmVsYXRpb25zaGlw>> : "Requests recommendations from\n<size:16>[gRPC]</size>"
Storefront --> Shipping <<Relationship-UmVsYXRpb25zaGlw>> : "Requests shipping quotes from\n<size:16>[HTTP]</size>"
Storefront --> FeatureFlags <<Relationship-UmVsYXRpb25zaGlwLEZlYXR1cmVGbGFn>> : "Evaluates feature flags via\n<size:16>[gRPC / OFREP]</size>"
Storefront --> ObservabilityPlatform <<Relationship-UmVsYXRpb25zaGlwLFRlbGVtZXRyeQ==>> : "Exports telemetry via\n<size:16>[OTLP]</size>"
Customer --> Storefront <<Relationship-UmVsYXRpb25zaGlw>> : "Browses, buys, and chats via\n<size:16>[HTTPS]</size>"
LoadGenerator --> Storefront <<Relationship-UmVsYXRpb25zaGlw>> : "Drives synthetic traffic through\n<size:16>[HTTPS / k6]</size>"

@enduml