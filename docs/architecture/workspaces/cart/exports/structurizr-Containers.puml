@startuml
title <size:24>Container View: Cart</size>\n<size:24>Inside Cart — service plus its own data store.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container
  .Element-RWxlbWVudCxDb250YWluZXI= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Database
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Cart
  .Boundary-Q2FydA== {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #1168bd;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Cart\n<size:16>[Software System]</size>" <<Boundary-Q2FydA==>> {
  rectangle "==Cart Service\n<size:16>[Container: C# / .NET]</size>\n\nHolds each user's shopping cart." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Cart.CartService
  database "==Cart Store\n<size:16>[Container: Valkey (Redis-compatible)]</size>\n\nCart contents keyed by user." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as Cart.CartStore
}

Cart.CartService --> Cart.CartStore <<Relationship-UmVsYXRpb25zaGlw>> : "Reads and writes cart state in\n<size:16>[RESP / TCP]</size>"

@enduml